}

interface PendingPOQueueNode {
  id: string;
  poNumber: string;
  qrCodeToken?: string;
  purchaseRequestId: string;
  purchaseRequest: {
    justification: string;
    itemsPayload?: any;
    status: PRStatus;
    createdAt: string;
    department: { code: string; name: string };
  };
}

type IconProps = { className?: string };

