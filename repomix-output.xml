  return (
    <article
      className={`bg-white rounded-2xl border shadow-sm overflow-hidden transition-all ${
        isReturned
          ? 'border-orange-300 ring-1 ring-orange-200'
          : isDeclined
          ? 'border-rose-200'
          : isClosed
          ? 'border-emerald-200'
          : 'border-slate-200'
