  onChange,
  approveLabel = 'Approve',
  returnLabel = 'Return for Correction',
  declineLabel = 'Decline',
}: {
  value: string;
  onChange: (v: 'APPROVE' | 'RETURN_FOR_CORRECTION' | 'DECLINE') => void;
  approveLabel?: string;
  returnLabel?: string;
  declineLabel?: string;
}) {
