          isReturned
            ? 'bg-orange-400'
            : isDeclined
            ? 'bg-rose-400'
            : isClosed
            ? 'bg-emerald-500'
            : req.status === PRStatus.Pending_Business_Approval
            ? 'bg-amber-400'
            : req.status === PRStatus.Pending_Admin_Approval
            ? 'bg-sky-400'
            : 'bg-[#047857]'
